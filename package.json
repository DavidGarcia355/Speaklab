{
  "name": "speaklab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:local": "node scripts/local-dev.mjs start",
    "dev:status": "node scripts/local-dev.mjs status",
    "dev:stop": "node scripts/local-dev.mjs stop",
    "ai:doctor": "node scripts/local-ai.mjs doctor",
    "ai:seed": "node scripts/local-ai.mjs seed",
    "ai:reset": "node scripts/local-ai.mjs reset",
    "ai:smoke": "node scripts/local-ai.mjs smoke",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.4",
    "@vercel/blob": "^2.3.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.1",
    "next-auth": "^4.24.13",
    "openai": "^4.104.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "6.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
