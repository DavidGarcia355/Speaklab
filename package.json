{
  "name": "speaklab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:local": "node scripts/local-dev.mjs start",
    "dev:status": "node scripts/local-dev.mjs status",
    "dev:stop": "node scripts/local-dev.mjs stop",
    "ai:doctor": "node scripts/local-ai.mjs doctor",
    "ai:seed": "node scripts/local-ai.mjs seed",
    "ai:reset": "node scripts/local-ai.mjs reset",
    "ai:smoke": "node scripts/local-ai.mjs smoke",
    "ai:benchmark": "tsx scripts/grading-benchmark.ts",
    "ai:benchmark:paid": "tsx scripts/grading-benchmark.ts --allow-paid",
    "ai:profit": "tsx scripts/grading-profit.ts",
    "stripe:catalog:plan": "tsx scripts/stripe-setup.ts",
    "stripe:catalog:test:apply": "tsx scripts/stripe-setup.ts --apply",
    "stripe:catalog:verify": "tsx scripts/stripe-verify-runtime.ts",
    "stripe:payment-methods:plan": "tsx scripts/stripe-payment-methods-setup.ts",
    "stripe:payment-methods:test:apply": "tsx scripts/stripe-payment-methods-setup.ts --apply",
    "stripe:portal:plan": "tsx scripts/stripe-portal-setup.ts",
    "stripe:portal:test:apply": "tsx scripts/stripe-portal-setup.ts --apply",
    "stripe:live:setup": "tsx scripts/stripe-live-setup.ts",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run test && npm run typecheck && npm run build",
    "release:check": "node scripts/predeploy-check.mjs && npm run check",
    "release:check:worktree": "node scripts/predeploy-check.mjs --allow-dirty && npm run check"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.56",
    "@libsql/client": "^0.17.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.4",
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.70",
    "lucide-react": "^0.577.0",
    "mediabunny": "1.55.2",
    "next": "16.3.1",
    "next-auth": "^4.24.15",
    "openai": "6.44.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "6.0.2",
    "stripe": "22.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
