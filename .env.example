# Required server env
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# Optional: Microsoft 365 school sign-in (Azure AD)
# Register an app at portal.azure.com → App registrations. The provider stays
# disabled unless both the ID and secret are present.
# Set tenant to "organizations" for work/school accounts, "common" for any
# Microsoft account, or use a specific school tenant ID.
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=
AUTH_MICROSOFT_TENANT_ID=organizations
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Legacy public store used by older student recordings and teacher worksheets.
# Runtime code must not write here; keep a short-lived token only for the guarded migration.
BLOB_READ_WRITE_TOKEN=
# Dedicated private store for student recordings and teacher worksheets. Vercel
# production uses OIDC with the store ID; the token is only for explicit
# local/off-Vercel migration work and should be removed after verification.
AUDIO_BLOB_STORE_ID=
AUDIO_READ_WRITE_TOKEN=
# Required only to call the cleanup cron route; use a long random server-only
# value. Licensed Stripe subscription billing and Checkout do not depend on it.
CRON_SECRET=
# Local development: http://localhost:3000
# Production: replace with the exact canonical HTTPS deployment origin.
NEXTAUTH_URL=http://localhost:3000

# Comma-separated emails auto-granted the teacher role on sign-in.
# This does not grant an AI allowance or paid access.
# Re-applied on EVERY sign-in, so adding someone here fixes an account that
# already signed in as a student.
TEACHER_ALLOWLIST=

# Comma-separated emails allowed to access /admin. Admin emails automatically
# receive the teacher role too, but not an AI allowance - no need to also list
# them in TEACHER_ALLOWLIST.
ADMIN_EMAILS=

# Deprecated: single-admin form, still honored and merged with ADMIN_EMAILS.
ADMIN_EMAIL=

# Production teacher self-registration is closed unless this is true or the
# teacher email is in TEACHER_ALLOWLIST. Keep false for district review.
ALLOW_TEACHER_SELF_REGISTRATION=false

# Private TryHabla HQ admin alerts. Intents are durably queued regardless of
# this switch; only exact "true" enables delivery. Keep false until every
# private Discord destination has passed the sandbox verification checklist.
DISCORD_ADMIN_ALERTS_ENABLED=false
# Set explicitly on Vercel: production, preview, development, or test.
DISCORD_ALERTS_ENV=development
# Optional dedicated HMAC secret for irreversible internal references. Use at
# least 32 random characters. AUTH_SECRET is the server-only fallback.
DISCORD_ALERTS_REFERENCE_SECRET=
# Rolling 24-hour p95 grading-latency incident target (1,000-600,000 ms).
DISCORD_AI_P95_TARGET_MS=60000
# Production-only destination secrets. Never expose through NEXT_PUBLIC_*.
DISCORD_TRACTION_WEBHOOK_URL=
DISCORD_REVENUE_WEBHOOK_URL=
DISCORD_MILESTONES_WEBHOOK_URL=
DISCORD_PULSE_WEBHOOK_URL=
DISCORD_INCIDENTS_WEBHOOK_URL=
# Preview, Development, and Test are hard-routed to this one bot-testing hook.
DISCORD_TEST_WEBHOOK_URL=
# Removed legacy direct-delivery setting; retained here only as a warning.
# DISCORD_WEBHOOK_URL is ignored.

# Resend API key for teacher confirmation emails
# Get one free at resend.com - 3,000 emails/month free
RESEND_API_KEY=

# Set to "true" to bypass auth in local dev. Never set in production.
LOCAL_DEV_BYPASS_AUTH=false

# Set to "true" to restrict submissions to a specific email domain.
# Leave unset during pilots.
ENFORCE_STUDENT_DOMAIN=false
STUDENT_DOMAIN=

# Optional: require students to be on the class roster before submission.
REQUIRE_ROSTER_FOR_SUBMISSIONS=false

# Optional rate-limit tuning for production.
SUBMISSION_RATE_LIMIT_PER_HOUR=120
AUTH_RATE_LIMIT_PER_HOUR=250
GRADEBOOK_RATE_LIMIT_PER_HOUR=30

# Experimental AI grading. Keep disabled unless reviewed for student-data use.
# Candidate low-cost models only; benchmark and approve the exact model IDs before rollout.
AI_GRADING_ENABLED=false
# Keep bulk off until grading is moved to a durable background job with progress/resume.
AI_BULK_GRADING_ENABLED=false
AI_TRANSCRIPTION_PROVIDER=openai
AI_GRADING_PROVIDER=openai
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_GRADING_MODEL=gpt-5-nano
GRADING_DEFAULT_PROVIDER=openai
GRADING_DEFAULT_MODEL=gpt-5-nano
GRADING_ESCALATION_PROVIDER=openai
GRADING_ESCALATION_MODEL=gpt-5-mini
# Keep the candidate path transcription-first. Changing to auto or
# gemini_direct adds Google as a student-audio subprocessor and requires review.
GRADING_AUDIO_STRATEGY=transcribe_then_grade
# Keep "paid" for Free lifetime, explicit manual pilot, and verified Teacher allowances.
# "all" also requires closed teacher self-registration.
AI_ACCESS_MODE=paid
# Comma-separated emergency suspension list, including when AI_ACCESS_MODE=all.
AI_TEACHER_DENYLIST=
# Keep blank until privacy, retention, school authorization, provider controls,
# and the exact model set are reviewed. Then use the current versioned attestation.
AI_STUDENT_DATA_APPROVED=
# Approved value for this policy/code version: reviewed-2026-08-25
AI_MAX_AUDIO_SECONDS=300
AI_MAX_GENERATIONS_PER_SUBMISSION=10
AI_GENERATION_COOLDOWN_SECONDS=3
AI_DAILY_TEACHER_LIMIT=100    # successful-result attempts; sized for a high-volume individual teacher
GRADING_DAILY_TEACHER_LIMIT=300 # provider requests; transcription + grading can use multiple calls per result
GRADING_MONTHLY_TEACHER_LIMIT=10000
GRADING_MONTHLY_TEACHER_COST_LIMIT=50
AI_DAILY_GLOBAL_LIMIT=500     # app-wide cap across ALL teachers combined; size this to your budget
AI_MONTHLY_BUDGET_USD=200     # conservative app-side reservation ceiling; also set OpenAI's project hard limit
AI_RESERVED_COST_USD_PER_GENERATION=0.04 # reserves worst-case cost before calling providers
AI_PROVIDER_TIMEOUT_MS=120000
AI_PROVIDER_MAX_RETRIES=2
AI_GRADING_MAX_OUTPUT_TOKENS=1200
OPENAI_API_KEY=              # https://platform.openai.com/api-keys
AI_GATEWAY_ENABLED=true      # set false to use OPENAI_API_KEY directly on Vercel
AI_GATEWAY_API_KEY=          # optional locally; Vercel deployments use automatic OIDC
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional Teacher subscription billing. These are deliberately separate so new Checkout
# can be paused without breaking signed subscription updates or Customer Portal
# access for existing subscribers. Enable subscriptions only after the catalog and
# webhook pass the sandbox checklist; enable Checkout last.
STRIPE_SUBSCRIPTION_BILLING_ENABLED=false
STRIPE_CHECKOUT_ENABLED=false
# Test/sandbox key used only by the ordinary Stripe setup scripts; those commands reject live keys.
STRIPE_TEST_SECRET_KEY=
# Temporary local-only credential and explicit approval gate for the separately
# armed live setup tool. Never deploy this credential or leave approval enabled.
STRIPE_LIVE_SETUP_SECRET_KEY=
STRIPE_LIVE_SETUP_APPROVED=false
# Exact Stripe platform account for this deployment. Runtime and setup commands remotely verify it.
STRIPE_ACCOUNT_ID=
# Tooling-only copy of the sandbox card-only pmc_ ID. The Payment Method setup command prints it.
STRIPE_TEST_PAYMENT_METHOD_CONFIGURATION_ID=
# Runtime server credentials. Use test values first; never expose these through NEXT_PUBLIC_*.
# Keep the webhook secret and client credential available for the full lifetime
# of every subscription, including while Checkout or AI access is paused.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Exact active card-only Payment Method Configuration for this Stripe mode.
# Provision the test value with `npm run stripe:payment-methods:test:apply`.
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=
# Exact Customer Portal v3 configuration for this Stripe mode. Provision the test value only after
# the card-only pmc_ exists; use the separately armed live tool for reviewed production IDs.
STRIPE_PORTAL_CONFIGURATION_ID=
# Exact v3 $20/month licensed Teacher Price. The test-only setup script prints
# the sandbox ID after `npx tsx scripts/stripe-setup.ts --apply`.
STRIPE_TRYHABLA_TEACHER_PRICE_ID=
# Must remain false for this release; automatic or manual tax requires a later reviewed contract.
STRIPE_AUTOMATIC_TAX_ENABLED=false
# A live secret is rejected unless NODE_ENV=production and this explicit switch is true.
STRIPE_ALLOW_LIVE=false

# Optional client env (only if intentionally used by the app)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
