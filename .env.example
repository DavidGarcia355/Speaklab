# Required server env
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# Optional: Microsoft / Outlook sign-in (Azure AD)
# Register an app at portal.azure.com → App registrations
# Set tenant to "common" for any Microsoft account, or your school tenant ID
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=
AUTH_MICROSOFT_TENANT_ID=common
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
NEXTAUTH_URL=https://your-project.vercel.app
TEACHER_ALLOWLIST=

# Founder email - only this email can access /admin
ADMIN_EMAIL=

# Discord webhook URL for founder activity pings
DISCORD_WEBHOOK_URL=

# Resend API key for teacher confirmation emails
# Get one free at resend.com - 3,000 emails/month free
RESEND_API_KEY=

# Set to "true" to bypass auth in local dev. Never set in production.
LOCAL_DEV_BYPASS_AUTH=false

# Set to "true" to restrict submissions to a specific email domain.
# Leave unset during pilots.
ENFORCE_STUDENT_DOMAIN=false
STUDENT_DOMAIN=

# Optional rate-limit tuning for production.
SUBMISSION_RATE_LIMIT_PER_HOUR=120
AUTH_RATE_LIMIT_PER_HOUR=250
GRADEBOOK_RATE_LIMIT_PER_HOUR=30

# Optional client env (only if intentionally used by the app)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
