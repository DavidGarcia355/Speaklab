# Required server env
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
NEXTAUTH_URL=https://your-project.vercel.app
TEACHER_ALLOWLIST=

# Set to "true" to bypass auth in local dev. Never set in production.
LOCAL_DEV_BYPASS_AUTH=false

# Set to "true" to restrict submissions to a specific email domain.
# Leave unset during pilots.
ENFORCE_STUDENT_DOMAIN=false
STUDENT_DOMAIN=

# Optional rate-limit tuning for production.
SUBMISSION_RATE_LIMIT_PER_HOUR=50
AUTH_RATE_LIMIT_PER_HOUR=100
GRADEBOOK_RATE_LIMIT_PER_HOUR=10

# Optional client env (only if intentionally used by the app)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
