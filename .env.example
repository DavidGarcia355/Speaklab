# Required server env
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# Optional: Microsoft / Outlook sign-in (Azure AD)
# Register an app at portal.azure.com → App registrations
# Set tenant to "common" for any Microsoft account, or your school tenant ID
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=
AUTH_MICROSOFT_TENANT_ID=common
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
NEXTAUTH_URL=https://your-project.vercel.app

# Comma-separated emails auto-granted teacher role + AI grading on sign-in.
# Re-applied on EVERY sign-in, so adding someone here fixes an account that
# already signed in as a student.
TEACHER_ALLOWLIST=

# Comma-separated emails allowed to access /admin. Admin emails automatically
# receive teacher role and AI grading access too - no need to also list them
# in TEACHER_ALLOWLIST.
ADMIN_EMAILS=

# Deprecated: single-admin form, still honored and merged with ADMIN_EMAILS.
ADMIN_EMAIL=

# Production teacher self-registration is closed unless this is true or the
# teacher email is in TEACHER_ALLOWLIST. Keep false for district review.
ALLOW_TEACHER_SELF_REGISTRATION=false

# Discord webhook URL for founder activity pings
DISCORD_WEBHOOK_URL=

# Resend API key for teacher confirmation emails
# Get one free at resend.com - 3,000 emails/month free
RESEND_API_KEY=

# Set to "true" to bypass auth in local dev. Never set in production.
LOCAL_DEV_BYPASS_AUTH=false

# Set to "true" to restrict submissions to a specific email domain.
# Leave unset during pilots.
ENFORCE_STUDENT_DOMAIN=false
STUDENT_DOMAIN=

# Optional: require students to be on the class roster before submission.
REQUIRE_ROSTER_FOR_SUBMISSIONS=false

# Optional rate-limit tuning for production.
SUBMISSION_RATE_LIMIT_PER_HOUR=120
AUTH_RATE_LIMIT_PER_HOUR=250
GRADEBOOK_RATE_LIMIT_PER_HOUR=30

# Experimental AI grading. Keep disabled unless reviewed for student-data use.
# Costs ~$0.012/generation (whisper-1 transcription + gpt-4o-mini grading) at
# a ~2-minute submission. See docs/local-ai-testing.md for the cost breakdown.
AI_GRADING_ENABLED=false
# Keep bulk off until grading is moved to a durable background job with progress/resume.
AI_BULK_GRADING_ENABLED=false
AI_TRANSCRIPTION_PROVIDER=openai
AI_GRADING_PROVIDER=openai
AI_TRANSCRIPTION_MODEL=whisper-1
AI_GRADING_MODEL=gpt-4o-mini
# Keep "paid" for manual entitlements. "all" also requires closed teacher self-registration.
AI_ACCESS_MODE=paid
# Comma-separated emergency suspension list, including when AI_ACCESS_MODE=all.
AI_TEACHER_DENYLIST=
# Required in production after privacy, retention, district, and OpenAI data-control review.
AI_STUDENT_DATA_APPROVED=false
AI_MAX_AUDIO_SECONDS=300
AI_MAX_GENERATIONS_PER_SUBMISSION=10
AI_GENERATION_COOLDOWN_SECONDS=3
AI_DAILY_TEACHER_LIMIT=20     # covers a 6-class/180-student teacher (~468 gens/mo) with headroom
AI_DAILY_GLOBAL_LIMIT=500     # app-wide cap across ALL teachers combined; size this to your budget
AI_MONTHLY_BUDGET_USD=200     # conservative app-side reservation ceiling; also set OpenAI's project hard limit
AI_RESERVED_COST_USD_PER_GENERATION=0.04 # reserves worst-case cost before calling providers
AI_PROVIDER_TIMEOUT_MS=120000
AI_PROVIDER_MAX_RETRIES=2
AI_GRADING_MAX_OUTPUT_TOKENS=1200
OPENAI_API_KEY=              # https://platform.openai.com/api-keys
AI_GATEWAY_ENABLED=true      # set false to use OPENAI_API_KEY directly on Vercel
AI_GATEWAY_API_KEY=          # optional locally; Vercel deployments use automatic OIDC
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional client env (only if intentionally used by the app)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
